<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.brewbite.ui.barista.BaristaController">
    <ListView fx:id="orderListView" prefHeight="300.0" />

    <HBox spacing="10">
        <Button fx:id="advanceButton" text="Advance Status" onAction="#onAdvanceClicked" />
        <Button fx:id="completeButton" text="Complete Order" onAction="#onCompleteClicked" />
    </HBox>
</VBox>